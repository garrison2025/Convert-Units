{
  "name": "exactunit-converter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run audit:seo",
    "dev": "npm run build && npx --yes serve dist",
    "audit:seo": "node scripts/audit.mjs && node scripts/release-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
